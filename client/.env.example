VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_DELIVERY_PINCODES=509208

# Production only (Vercel): your Render backend URL, no trailing slash
# VITE_API_URL=https://farm2home-api.onrender.com

# Must match server ADMIN_EMAILS (comma-separated)
VITE_ADMIN_EMAILS=your-admin@email.com
# Optional. Riders are added from Admin → Riders. This list is only an extra allow-list.
# Admins can also open /delivery.
VITE_DELIVERY_EMAILS=

# Google sign-in — enable Google provider in Firebase Console → Authentication
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# VITE_USE_GOOGLE_PLACES=true

# Farm location for the delivery route map (Narayanpet)
VITE_FARM_LAT=16.7458
VITE_FARM_LNG=77.4958
VITE_FARM_NAME=Farm2Home
